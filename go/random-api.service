[Unit]
Description=random-api (random image / hitokoto / daily)
Documentation=file:///mnt/random-api/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/random-api
Environment=PORT=8790
Environment=IMG_BASE_URL=https://img.ifyi.top
Environment=APP_ROOT=/mnt/random-api
ExecStart=/mnt/random-api/bin/random-api
Restart=always
RestartSec=3
LimitNOFILE=65535

StandardOutput=append:/mnt/random-api/logs/stdout.log
StandardError=append:/mnt/random-api/logs/stderr.log

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/mnt/random-api

[Install]
WantedBy=multi-user.target
