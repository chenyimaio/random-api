[
  {
    "id": 1,
    "hitokoto": "山重水复疑无路，柳暗花明又一村。",
    "type": "d",
    "from": "游山西村",
    "from_who": "陆游",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 2,
    "hitokoto": "长风破浪会有时，直挂云帆济沧海。",
    "type": "d",
    "from": "行路难",
    "from_who": "李白",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 3,
    "hitokoto": "天生我材必有用，千金散尽还复来。",
    "type": "d",
    "from": "将进酒",
    "from_who": "李白",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 4,
    "hitokoto": "会当凌绝顶，一览众山小。",
    "type": "d",
    "from": "望岳",
    "from_who": "杜甫",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 5,
    "hitokoto": "落霞与孤鹜齐飞，秋水共长天一色。",
    "type": "d",
    "from": "滕王阁序",
    "from_who": "王勃",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 6,
    "hitokoto": "海内存知己，天涯若比邻。",
    "type": "d",
    "from": "送杜少府之任蜀州",
    "from_who": "王勃",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 7,
    "hitokoto": "但愿人长久，千里共婵娟。",
    "type": "d",
    "from": "水调歌头",
    "from_who": "苏轼",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 8,
    "hitokoto": "人生如逆旅，我亦是行人。",
    "type": "d",
    "from": "临江仙·送钱穆父",
    "from_who": "苏轼",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 9,
    "hitokoto": "竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。",
    "type": "d",
    "from": "定风波",
    "from_who": "苏轼",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 19
  },
  {
    "id": 10,
    "hitokoto": "不以物喜，不以己悲。",
    "type": "d",
    "from": "岳阳楼记",
    "from_who": "范仲淹",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 11,
    "hitokoto": "先天下之忧而忧，后天下之乐而乐。",
    "type": "d",
    "from": "岳阳楼记",
    "from_who": "范仲淹",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 12,
    "hitokoto": "少年易老学难成，一寸光阴不可轻。",
    "type": "d",
    "from": "偶成",
    "from_who": "朱熹",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 13,
    "hitokoto": "问渠那得清如许？为有源头活水来。",
    "type": "d",
    "from": "观书有感",
    "from_who": "朱熹",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 14,
    "hitokoto": "纸上得来终觉浅，绝知此事要躬行。",
    "type": "d",
    "from": "冬夜读书示子聿",
    "from_who": "陆游",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 15,
    "hitokoto": "花开堪折直须折，莫待无花空折枝。",
    "type": "d",
    "from": "金缕衣",
    "from_who": "杜秋娘",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 16,
    "hitokoto": "欲穷千里目，更上一层楼。",
    "type": "d",
    "from": "登鹳雀楼",
    "from_who": "王之涣",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 17,
    "hitokoto": "人生自古谁无死？留取丹心照汗青。",
    "type": "d",
    "from": "过零丁洋",
    "from_who": "文天祥",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 18,
    "hitokoto": "苟利国家生死以，岂因祸福避趋之。",
    "type": "d",
    "from": "赴戍登程口占示家人",
    "from_who": "林则徐",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 19,
    "hitokoto": "千磨万击还坚劲，任尔东西南北风。",
    "type": "d",
    "from": "竹石",
    "from_who": "郑燮",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 20,
    "hitokoto": "路漫漫其修远兮，吾将上下而求索。",
    "type": "d",
    "from": "离骚",
    "from_who": "屈原",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 21,
    "hitokoto": "天行健，君子以自强不息。",
    "type": "d",
    "from": "周易·乾卦",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 22,
    "hitokoto": "地势坤，君子以厚德载物。",
    "type": "d",
    "from": "周易·坤卦",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 23,
    "hitokoto": "君子坦荡荡，小人长戚戚。",
    "type": "d",
    "from": "论语·述而",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 24,
    "hitokoto": "三人行，必有我师焉。",
    "type": "d",
    "from": "论语·述而",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 25,
    "hitokoto": "学而不思则罔，思而不学则殆。",
    "type": "d",
    "from": "论语·为政",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 14
  },
  {
    "id": 26,
    "hitokoto": "知之为知之，不知为不知，是知也。",
    "type": "d",
    "from": "论语·为政",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 27,
    "hitokoto": "己所不欲，勿施于人。",
    "type": "d",
    "from": "论语·卫灵公",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 28,
    "hitokoto": "千里之行，始于足下。",
    "type": "d",
    "from": "道德经",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 29,
    "hitokoto": "上善若水，水善利万物而不争。",
    "type": "d",
    "from": "道德经",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 14
  },
  {
    "id": 30,
    "hitokoto": "知人者智，自知者明。",
    "type": "d",
    "from": "道德经",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 31,
    "hitokoto": "祸兮福之所倚，福兮祸之所伏。",
    "type": "d",
    "from": "道德经",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 14
  },
  {
    "id": 32,
    "hitokoto": "锲而舍之，朽木不折；锲而不舍，金石可镂。",
    "type": "d",
    "from": "荀子·劝学",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 20
  },
  {
    "id": 33,
    "hitokoto": "不积跬步，无以至千里；不积小流，无以成江海。",
    "type": "d",
    "from": "荀子·劝学",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 22
  },
  {
    "id": 34,
    "hitokoto": "业精于勤，荒于嬉；行成于思，毁于随。",
    "type": "d",
    "from": "进学解",
    "from_who": "韩愈",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 18
  },
  {
    "id": 35,
    "hitokoto": "莫愁前路无知己，天下谁人不识君。",
    "type": "d",
    "from": "别董大",
    "from_who": "高适",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 36,
    "hitokoto": "沉舟侧畔千帆过，病树前头万木春。",
    "type": "d",
    "from": "酬乐天扬州初逢席上见赠",
    "from_who": "刘禹锡",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 37,
    "hitokoto": "山不厌高，海不厌深。",
    "type": "d",
    "from": "短歌行",
    "from_who": "曹操",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 38,
    "hitokoto": "老骥伏枥，志在千里。",
    "type": "d",
    "from": "龟虽寿",
    "from_who": "曹操",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 39,
    "hitokoto": "采菊东篱下，悠然见南山。",
    "type": "d",
    "from": "饮酒·其五",
    "from_who": "陶渊明",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 40,
    "hitokoto": "盛年不重来，一日难再晨。",
    "type": "d",
    "from": "杂诗",
    "from_who": "陶渊明",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 41,
    "hitokoto": "悟已往之不谏，知来者之可追。",
    "type": "d",
    "from": "归去来兮辞",
    "from_who": "陶渊明",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 14
  },
  {
    "id": 42,
    "hitokoto": "青青子衿，悠悠我心。",
    "type": "d",
    "from": "诗经·郑风·子衿",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 43,
    "hitokoto": "桃之夭夭，灼灼其华。",
    "type": "d",
    "from": "诗经·周南·桃夭",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 44,
    "hitokoto": "蒹葭苍苍，白露为霜。",
    "type": "d",
    "from": "诗经·秦风·蒹葭",
    "from_who": null,
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 10
  },
  {
    "id": 45,
    "hitokoto": "春风得意马蹄疾，一日看尽长安花。",
    "type": "d",
    "from": "登科后",
    "from_who": "孟郊",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 46,
    "hitokoto": "忽如一夜春风来，千树万树梨花开。",
    "type": "d",
    "from": "白雪歌送武判官归京",
    "from_who": "岑参",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 16
  },
  {
    "id": 47,
    "hitokoto": "大漠孤烟直，长河落日圆。",
    "type": "d",
    "from": "使至塞上",
    "from_who": "王维",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 48,
    "hitokoto": "明月松间照，清泉石上流。",
    "type": "d",
    "from": "山居秋暝",
    "from_who": "王维",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 49,
    "hitokoto": "行到水穷处，坐看云起时。",
    "type": "d",
    "from": "终南别业",
    "from_who": "王维",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 12
  },
  {
    "id": 50,
    "hitokoto": "问君能有几多愁？恰似一江春水向东流。",
    "type": "d",
    "from": "虞美人",
    "from_who": "李煜",
    "creator": "classic",
    "created_at": "2026-01-01T00:00:00Z",
    "length": 18
  }
]
